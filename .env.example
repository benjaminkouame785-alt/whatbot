# Copie ce fichier en ".env" et remplis tes propres valeurs. Ne le partage JAMAIS.

# Numéros autorisés à envoyer des commandes, séparés par des virgules.
# Format Twilio WhatsApp : whatsapp:+<indicatif><numero>
AUTHORIZED_NUMBERS=whatsapp:+2250700000000

# Mot de passe qui doit précéder chaque commande envoyée par WhatsApp.
SECRET_PASSPHRASE=ChangeMoiPourUnMotDePasseLongEtUnique

# Dossier depuis lequel les commandes sont exécutées sur ta machine
BOT_WORKDIR=/home/ton_utilisateur

# Timeout en secondes par commande
COMMAND_TIMEOUT=25

# Port local du serveur Flask
PORT=5000
